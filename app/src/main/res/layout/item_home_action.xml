<?xml version="1.0" encoding="utf-8"?>
<!-- One action in the home's menu: an icon, what it does, and a line of detail when it needs one. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/home_action_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:paddingLeft="@dimen/home_action_padding"
    android:paddingRight="@dimen/home_action_padding"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/home_action_icon"
        android:layout_width="@dimen/home_action_icon"
        android:layout_height="@dimen/home_action_icon"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/home_action_padding"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_action_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/home_action_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_action_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/home_action_detail_text"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
