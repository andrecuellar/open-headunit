<?xml version="1.0" encoding="utf-8"?>
<!-- The home's own small menu: what the long press was on, the actions with a line on what each
     one does, and a way out. HomeActionDialog fills the rows and paints it with the home's look. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/home_actions_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/home_action_padding">

        <TextView
            android:id="@+id/home_actions_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/home_action_padding"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="@dimen/home_action_title_text"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/home_actions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="@drawable/home_gap"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/home_actions_cancel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_action_row_height"
            android:layout_marginTop="@dimen/home_action_padding"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cancel"
            android:textSize="@dimen/home_action_text"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
