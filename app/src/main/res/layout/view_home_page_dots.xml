<?xml version="1.0" encoding="utf-8"?>
<!-- Where the driver is among the home's pages. Each dot is a button as wide as a finger, filled in
     by HomeFragment.renderDots, so a page can be reached without swiping. Hidden with one page. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_page_dots"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_dots_height"
    android:orientation="horizontal"
    android:gravity="center"
    android:visibility="gone" />
